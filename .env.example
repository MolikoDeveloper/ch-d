# Server
PORT=3000
DB_PATH=./data/chile.sqlite

# Mercado Público / ChileCompra
# Solicita/usa tu ticket personal y NO lo subas al repositorio.
CHILECOMPRA_TICKET=
SYNC_CHILECOMPRA_FROM=
SYNC_CHILECOMPRA_TO=

# Banco Central de Chile BDE REST API
# Token personal de https://si3.bcentral.cl/estadisticas/Principal1/Web_Services/
BCCH_API_KEY=
# Descargas simultáneas de series. Mantener bajo para no castigar el servicio.
BCCH_CONCURRENCY=2

# Energía Abierta / CNE
ENERGIA_RESOURCE_LIMIT=12

# SINIM / SUBDERE
# Vacío/no definido = sincronizar las 345 fichas comunales vigentes.
# Útil durante pruebas: SINIM_COMMUNE_LIMIT=10
SINIM_COMMUNE_LIMIT=

# Registro Social de Hogares / BIDAT
# El conector selecciona automáticamente el CSV mensual más reciente.

# CASEN / MDSF - estimaciones comunales oficiales
# Vacío = todos los años comunales descubiertos en BIDAT/CKAN.
# Ejemplo rápido: CASEN_YEARS=2024
CASEN_YEARS=
# Limita recursos XLSX durante desarrollo; vacío = todos.
CASEN_RESOURCE_LIMIT=

# SII - estadísticas de empresas por comuna
# Usa el ZIP oficial EMPRESAS.zip y respeta '*' como dato suprimido por reserva tributaria.

# SERVEL - participación electoral territorial
# Límites de crawling útiles durante desarrollo.
SERVEL_PAGE_LIMIT=50
SERVEL_RESOURCE_LIMIT=100

# Presupuesto Abierto / DIPRES
# Sync normal: agregados institucionales, no el dump transaccional masivo.
# Uno o más años separados por coma. Vacío = año actual.
PRESUPUESTO_ABIERTO_YEARS=

# INE / SIMEL (SDMX)
# Por defecto se selecciona una muestra de flujos laborales relevantes.
INE_FLOW_LIMIT=6
# Opcional: IDs SDMX explícitos separados por coma. Vacío = autodetección por título.
INE_FLOWS=

# Geografía
GEO_SYNC_TIMEOUT_MS=60000

# Identidad legal / autenticación de futuras fuentes
# Añadir solo cuando una fuente oficial lo requiera y de acuerdo con sus términos.
LEGAL_NAME=
LEGAL_RUT=
LEGAL_EMAIL=
